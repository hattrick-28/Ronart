# =====================================================================
# Vercel → Project → Settings → Environment Variables
# Add each one for "Production" (and "Preview" if you use previews).
# Mark the secret ones as "Sensitive". NEVER commit real values to GitHub.
# =====================================================================

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...                 # Sensitive

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ronartapartments.com # no trailing slash
APP_SECRET=<random 64 chars>                      # Sensitive · openssl rand -hex 32
CRON_SECRET=<random 64 chars>                     # Sensitive · same value goes in 03_cron_sync.sql

# --- Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget,
#     hostnames: ronartapartments.com + the *.vercel.app domain) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...                   # Sensitive

# --- Payments: "mock" = test mode (no real money). "nlb" after NLB gives the data ---
PAYMENT_PROVIDER=mock
NLB_MERCHANT_ID=
NLB_TERMINAL_ID=
NLB_SECRET=                                       # Sensitive
NLB_GATEWAY_URL=

# --- Beds24 ---
BEDS24_PROPERTY_ID=<new property id>              # Beds24 → Settings → Properties
BEDS24_WEBHOOK_SECRET=<random 32 chars>           # Sensitive · openssl rand -hex 16

# Do NOT set DEMO_DATA in Vercel (local preview only).
